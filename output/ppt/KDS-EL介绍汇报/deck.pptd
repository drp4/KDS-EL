version: v2
title: KDS-EL 组合汇报
size: [960, 540]
theme:
  colors:
    paper: "#EFECE4"
    ink: "#24282D"
    primary: "#34515E"
    accent: "#C05621"
    gold: "#B08A2E"
    muted: "#6F6A62"
    line: "#CFC8BA"
    white: "#FFFFFF"
    light: "#E3DED2"
  textStyles:
    kicker:
      fontSize: 12
      color: "$accent"
      bold: true
      letterSpacing: 2
    title:
      fontSize: 28
      color: "$ink"
      bold: true
      lineHeight: 1.15
    body:
      fontSize: 14
      color: "$ink"
      lineHeight: 1.5
    small:
      fontSize: 11
      color: "$muted"
      lineHeight: 1.4
    caption:
      fontSize: 10
      color: "$muted"
      lineHeight: 1.3
  tableStyles:
    default:
      cellStyle:
        color: "$ink"
        fontSize: 11
        align: [left, middle]
        border: {style: solid, width: 1, color: "$line"}
      firstRowStyle:
        bold: true
        color: "$ink"
        fill: {type: solid, color: "#E3DED2"}
      bodyStyles:
        - {fill: {type: solid, color: "#F8F5ED"}}
        - {fill: {type: solid, color: "#FFFFFF"}}
pages:
  - pages/01_cover.page
  - pages/02_outline.page
  - pages/02_problem.page
  - pages/03_framework.page
  - pages/04_ker.page
  - pages/05_tps.page
  - pages/06_mi.page
  - pages/07_synergy.page
  - pages/08_experiment.page
  - pages/09_results.page
  - pages/10_evidence.page
  - pages/11_conclusion.page
