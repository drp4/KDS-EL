        <mxCell id="n_step_eval" value="&lt;b&gt;Swarm Trial Evaluation&lt;/b&gt;&amp;#xa;Particle &lt;b&gt;&lt;i&gt;x&lt;/i&gt;&lt;/b&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;&lt;sup&gt;(&lt;i&gt;t&lt;/i&gt;)&lt;/sup&gt; improves over personal best &lt;b&gt;&lt;i&gt;p&lt;/i&gt;&lt;/b&gt;&lt;sub&gt;best,&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;:&amp;#xa;&amp;delta;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;&lt;sup&gt;(&lt;i&gt;t&lt;/i&gt;)&lt;/sup&gt; = &lt;i&gt;f&lt;/i&gt;(&lt;b&gt;&lt;i&gt;p&lt;/i&gt;&lt;/b&gt;&lt;sub&gt;best,&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;, &lt;b&gt;&lt;i&gt;w&lt;/i&gt;&lt;/b&gt;) - &lt;i&gt;f&lt;/i&gt;(&lt;b&gt;&lt;i&gt;x&lt;/i&gt;&lt;/b&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;&lt;sup&gt;(&lt;i&gt;t&lt;/i&gt;)&lt;/sup&gt;, &lt;b&gt;&lt;i&gt;w&lt;/i&gt;&lt;/b&gt;) &amp;gt; 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;" parent="1" vertex="1">
