        <mxCell id="r4_lbl" value="&lt;b&gt;Physical Search Lesion (The Why)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="30" y="239" width="160" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="r4_f1" value="&lt;b&gt;[Lesion 1] Fatal Synergistic Loss:&lt;/b&gt;&amp;#xa;Verified critical biomarker is discarded;&amp;#xa;Accuracy collapses drastically&amp;#xa;(&amp;#916;Acc = -14.2%)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="190" y="239" width="150" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="r4_f2" value="&lt;b&gt;[Lesion 2] Noise Infiltration:&lt;/b&gt;&amp;#xa;Uncorrelated noisy gene is activated;&amp;#xa;Bloats feature count &amp;amp; causes&amp;#xa;severe wrapper overfitting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="340" y="239" width="150" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="r4_f3" value="Redundant dimension remains unpruned" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="490" y="239" width="150" height="68" as="geometry"/>
        </mxCell>
