          <mxGeometry x="880" y="239" width="150" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="r5_lbl" value="&lt;b&gt;Resulting Degraded Candidate &lt;i&gt;x&lt;/i&gt;&amp;apos;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="30" y="307" width="160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="r5_res" value="&lt;b&gt;&lt;i&gt;x&lt;/i&gt;&amp;apos; = [0, 1, 0, 1, ..., 0] &amp;#8712; {0, 1}&lt;sup&gt;&lt;i&gt;D&lt;/i&gt;&lt;/sup&gt;&lt;/b&gt;&amp;#xa;Degraded Fitness: &lt;i&gt;f&lt;/i&gt;(&lt;b&gt;&lt;i&gt;x&lt;/i&gt;&lt;/b&gt;&amp;apos;) = 0.2250 &amp;gg; &lt;i&gt;f&lt;/i&gt;(&lt;b&gt;&lt;i&gt;x&lt;/i&gt;&lt;/b&gt;&lt;sub&gt;&lt;i&gt;e&lt;/i&gt;&lt;/sub&gt;) = 0.0820 (Severe Fitness Deterioration &amp;amp; Wasted Classifier Budget)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontSize=10;fontStyle=1;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="190" y="307" width="840" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="c_summary" value="Theoretical Bottlenecks of Blind Perturbations in Ultra-High-Dimensional Search Spaces (&lt;i&gt;D&lt;/i&gt; &amp;gg; 10&lt;sup&gt;3&lt;/sup&gt;)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#000000;strokeWidth=1.2;verticalAlign=top;spacingTop=8;fontSize=11;fontStyle=1;fontFamily=Times New Roman;pointerEvents=0;" parent="1" vertex="1">
          <mxGeometry x="30" y="360" width="1000" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="n_box_s1" value="&lt;b&gt;Bottleneck 1: Infinitesimal Probability of Beneficial Modification&lt;/b&gt;&amp;#xa;In spaces with &lt;i&gt;D&lt;/i&gt; &amp;#8805; 10&lt;sup&gt;4&lt;/sup&gt; dimensions, the combinatorial neighborhood is 2&lt;sup&gt;&lt;i&gt;D&lt;/i&gt;&lt;/sup&gt;. An undirected random bit flip has an infinitesimal hit probability O(1/&lt;i&gt;D&lt;/i&gt;) &amp;#8776; 10&lt;sup&gt;-4&lt;/sup&gt; of modifying the few decisive biomarkers, while having an overwhelming probability (1 - &lt;i&gt;d&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt;/&lt;i&gt;D&lt;/i&gt;) &amp;#8776; 99.8% of perturbing irrelevant background noise." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="50" y="395" width="460" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="n_box_s2" value="&lt;b&gt;Bottleneck 2: Memoryless Search Amnesia&lt;/b&gt;&amp;#xa;Standard meta-heuristics immediately discard the fitness evaluation feedback of trial solutions after particle updates. The optimizer fails to accumulate historical knowledge regarding which features systematically improved classification accuracy versus which features induced error spikes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="550" y="395" width="460" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="n_box_s3" value="&lt;b&gt;The KDS-EL Theoretical Solution (Section 3.3)&lt;/b&gt;&amp;#xa;KDS-EL resolves these dilemmas through a closed loop: cumulative trial feedback is preserved in the continuous importance matrix &lt;b&gt;&lt;i&gt;W&lt;/i&gt;&lt;/b&gt; &amp;#8712; &amp;#8477;&lt;sup&gt;&lt;i&gt;D&lt;/i&gt;&lt;/sup&gt; with exponential decay &amp;gamma; = 0.99. The KER operator computes directional scores &amp;sigma;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt; = (1 - 2&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;&lt;i&gt;e&lt;/i&gt;,&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt;) &amp;middot; &lt;i&gt;W&lt;/i&gt;&lt;sub&gt;&lt;i&gt;j&lt;/i&gt;&lt;/sub&gt; to deterministically prune weak features (1 &amp;#8594; 0) and add strong features (0 &amp;#8594; 1) under bounded computation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontSize=10;fontStyle=1;fontFamily=Times New Roman;" parent="1" vertex="1">
          <mxGeometry x="50" y="505" width="960" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
