<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="f1-kds-el-conceptual" name="Figure 1: KDS-EL Architecture Framework"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="in" value="&amp;lt;b&amp;gt;High-Dimensional Dataset&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;$$X, Y$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="150" y="40" width="400" height="50" as="geometry" /></mxCell><mxCell id="s1" value="&amp;lt;b&amp;gt;&amp;lt;font color=&quot;#1E3A8A&quot;&amp;gt;MI-Prior Seeding&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Informed Prior &amp;amp; Stochastic Diversity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="150" y="110" width="400" height="55" as="geometry" /></mxCell><mxCell id="loop" value="&amp;lt;b&amp;gt;Main Evolutionary Loop (t = 1..T)&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F8FAFC;strokeColor=#64748B;fontFamily=Times New Roman;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="120" y="190" width="460" height="400" as="geometry" /></mxCell><mxCell id="w" value="&amp;lt;b&amp;gt;Cumulative Feature-Importance Matrix $$W$$&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;$$f_1, f_2, f_3, \dots, f_{D-2}, f_{D-1}, f_D$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="150" y="230" width="400" height="45" as="geometry" /></mxCell><mxCell id="p1" value="&amp;lt;b&amp;gt;Subpop 1 (Continuous PSO)&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="150" y="300" width="180" height="90" as="geometry" /></mxCell><mxCell id="p2" value="&amp;lt;b&amp;gt;Subpop 2 (Probability Sampling)&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="370" y="300" width="180" height="90" as="geometry" /></mxCell><mxCell id="tps" value="&amp;lt;b&amp;gt;Two-Phase Scheduling (TPS)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Pruning → Accuracy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="150" y="410" width="180" height="45" as="geometry" /></mxCell><mxCell id="ker" value="&amp;lt;b&amp;gt;Elite Refinement (KER)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Knowledge Perturbation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="370" y="410" width="180" height="45" as="geometry" /></mxCell><mxCell id="out" value="&amp;lt;b&amp;gt;&amp;lt;font color=&quot;#15803D&quot;&amp;gt;Optimal Compact Feature Subset $$x^\star$$&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="150" y="610" width="400" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>