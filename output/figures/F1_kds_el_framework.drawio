        <!-- Bottom note -->
        <mxCell id="note" value="&lt;font style=&quot;font-size:8px;font-style:italic&quot;&gt;DRS and KER are complementary: KER captures accuracy gains; DRS maintains structural diversity and compresses features. Not synergistic, but mutually enabling.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;strokeWidth=1;fontSize=8;fontFamily=Times New Roman;fontColor=#888888;" vertex="1" parent="1">
