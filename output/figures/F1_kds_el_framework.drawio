        <mxCell id="p1" value="&lt;b&gt;Prop. 1&lt;/b&gt;  E[NHD(pool)] &amp;gt; 0 (diversity lower bound)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#4A6485;strokeWidth=1;fontSize=8.5;fontFamily=Times New Roman;fontColor=#4A6485;" vertex="1" parent="1">
