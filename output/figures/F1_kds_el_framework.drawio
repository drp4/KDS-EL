        <mxCell id="k1" value="&lt;b&gt;Fitness Evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Classification accuracy (KNN)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA88C;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
