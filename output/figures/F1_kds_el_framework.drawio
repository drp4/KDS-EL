        <mxCell id="n3" value="&lt;b&gt;DRS Pool Construction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;NHD as 1st-class selection objective&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE4EF;strokeColor=#4A6485;strokeWidth=1.5;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
