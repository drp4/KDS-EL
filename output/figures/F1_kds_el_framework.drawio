        <mxCell id="out" value="&lt;b&gt;Single Optimal Feature Subset&lt;/b&gt;  —  biomarker panel with high accuracy, compact size, and structural diversity" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F0F5;strokeColor=#6A6A80;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
