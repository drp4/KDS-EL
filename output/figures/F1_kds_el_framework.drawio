        <mxCell id="8" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#7A8FA8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="155" width="520" height="265" as="geometry" />
