          <mxGeometry x="770" y="190" width="200" height="42" as="geometry" />
        </mxCell>

        <!-- KER Step 2: Improvement Detection -->
        <mxCell id="21" value="&lt;b&gt;2. Improvement Detection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;f(x') &amp;gt; f(Pbest) → record event&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA88C;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="770" y="248" width="200" height="42" as="geometry" />
        </mxCell>

        <!-- KER Step 3: Weight Update (highlighted) -->
        <mxCell id="22" value="&lt;b&gt;3. KER Weight Update&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;w_j += 1 for each flipped feature in improvement&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE8DC;strokeColor=#4A704A;strokeWidth=1.5;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="306" width="200" height="42" as="geometry" />
        </mxCell>

        <!-- KER Step 4: Feature Importance Vector -->
        <mxCell id="23" value="&lt;b&gt;4. Feature Importance Vector w&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A704A;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="364" width="200" height="36" as="geometry" />
        </mxCell>

        <!-- Proposition 2 -->
        <mxCell id="24" value="&lt;b&gt;Prop. 2&lt;/b&gt;  P(flip j) ≥ (1/N)(w_j/Σw)·p_mut&lt;br&gt;&lt;font style=&quot;font-size:7.5px&quot;&gt;Any subset reachable in finite steps&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2ED;strokeColor=#4A704A;strokeWidth=1;fontSize=8.5;fontFamily=Times New Roman;fontColor=#4A704A;" vertex="1" parent="1">
