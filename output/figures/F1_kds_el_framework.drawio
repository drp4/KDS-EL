        <mxCell id="9" value="&lt;b&gt;Structure Space&lt;/b&gt;  —  DRS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontFamily=Times New Roman;fontColor=#4A6485;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="158" width="280" height="16" as="geometry" />
        </mxCell>

        <!-- DRS Step 1: NHD Matrix -->
        <mxCell id="10" value="&lt;b&gt;1. NHD Matrix&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;NHD(i,j) = Hamming(i,j) / d&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="190" y="190" width="200" height="42" as="geometry" />
        </mxCell>

        <!-- DRS Step 2: Crowding Distance -->
        <mxCell id="11" value="&lt;b&gt;2. Crowding Distance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;with NHD weight α_cd(t) = (t/T)²&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="190" y="248" width="200" height="42" as="geometry" />
        </mxCell>

        <!-- DRS Step 3: Pool Construction (highlighted) -->
        <mxCell id="12" value="&lt;b&gt;3. DRS Pool Construction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;NHD as 1st-class selection objective&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE4EF;strokeColor=#4A6485;strokeWidth=1.5;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="306" width="200" height="42" as="geometry" />
        </mxCell>

        <!-- DRS Step 4: Diverse Pool -->
        <mxCell id="13" value="&lt;b&gt;4. Diverse Candidate Pool&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6485;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="364" width="200" height="36" as="geometry" />
