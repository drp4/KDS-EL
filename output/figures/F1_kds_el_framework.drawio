        <mxCell id="cb" value="&lt;b&gt;Challenge B:&lt;/b&gt; Improvement Signal Waste" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F4EF;strokeColor=#C4B59A;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#554433;align=left;spacingLeft=10;" vertex="1" parent="1">
