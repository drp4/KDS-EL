        <mxCell id="ssl" value="&lt;b&gt;Structure Space&lt;/b&gt;  —  DRS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontFamily=Times New Roman;fontColor=#4A6485;fontStyle=1;" vertex="1" parent="1">
