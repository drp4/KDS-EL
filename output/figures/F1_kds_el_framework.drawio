        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Crowding Distance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;with NHD weight a_cd(t) = (t/T)&lt;sup&gt;2&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
