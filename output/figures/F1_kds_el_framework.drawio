        <mxCell id="k2" value="&lt;b&gt;Improvement Detection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;f(x&amp;apos;) &amp;gt; f(Pbest) --&gt; record event&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA88C;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="770" y="248" width="200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="k3" value="&lt;b&gt;KER Weight Update&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;w_j += 1 for each flipped feature in improvement&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE8DC;strokeColor=#4A704A;strokeWidth=1.5;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="306" width="200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="k4" value="&lt;b&gt;Feature Importance Vector w&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A704A;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="364" width="200" height="36" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="&lt;b&gt;Prop. 2&lt;/b&gt;  P(flip j) &amp;ge; (1/N)(w_j/Sw)*p_mut&lt;br&gt;&lt;font style=&quot;font-size:7.5px&quot;&gt;Any subset reachable in finite steps&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2ED;strokeColor=#4A704A;strokeWidth=1;fontSize=8.5;fontFamily=Times New Roman;fontColor=#4A704A;" vertex="1" parent="1">
