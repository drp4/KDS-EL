<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="f4-tps-continuous" name="Figure 4: TPS Continuous Mechanism"><mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="f4_top" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="20" y="15" width="1360" height="240" as="geometry" /></mxCell><mxCell id="f4_main" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="20" y="270" width="1360" height="600" as="geometry" /></mxCell><mxCell id="it1" value="&amp;lt;b&amp;gt;Initialization ($t=1$)&amp;lt;/b&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#0F172A;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="60" y="30" width="140" height="25" as="geometry" /></mxCell><mxCell id="it70" value="&amp;lt;b&amp;gt;&amp;lt;font color=&quot;#1E3A8A&quot;&amp;gt;Phase Transition ($t=\tau T$)&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#0F172A;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="580" y="30" width="220" height="25" as="geometry" /></mxCell><mxCell id="it100" value="&amp;lt;b&amp;gt;Termination ($t=T$)&amp;lt;/b&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#0F172A;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="1140" y="30" width="140" height="25" as="geometry" /></mxCell><mxCell id="p1_card" value="&amp;lt;b&amp;gt;&amp;lt;font size=&quot;4&quot; color=&quot;#1D4ED8&quot;&amp;gt;Phase 1: Sparse Exploration&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;$$f(\mathbf{x}, \mathbf{w}) = w_{\mathrm{acc}} \cdot \mathrm{Error}(\mathbf{x}) + w_{\mathrm{feat}} \cdot \frac{\|\mathbf{x}\|_0}{D}$$&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;$$w_{\mathrm{feat}} &gt; w_{\mathrm{acc}}$$&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;align=center;verticalAlign=top;fontSize=12;fontColor=#0F172A;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="60" y="80" width="420" height="140" as="geometry" /></mxCell><mxCell id="trans_card" value="&amp;lt;b&amp;gt;&amp;lt;font size=&quot;4&quot; color=&quot;#1E3A8A&quot;&amp;gt;Adaptive Weight Shift&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;$$\mathbf{w}_{\mathrm{Phase\ 1}} \longrightarrow \mathbf{w}_{\mathrm{Phase\ 2}}$$&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;Switch at $t = \tau T$&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=center;verticalAlign=top;fontSize=12;fontColor=#0F172A;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="510" y="80" width="380" height="140" as="geometry" /></mxCell><mxCell id="p2_card" value="&amp;lt;b&amp;gt;&amp;lt;font size=&quot;4&quot; color=&quot;#1E3A8A&quot;&amp;gt;Phase 2: Accuracy Refinement&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;$$f(\mathbf{x}, \mathbf{w}) = w_{\mathrm{acc}} \cdot \mathrm{Error}(\mathbf{x}) + w_{\mathrm{feat}} \cdot \frac{\|\mathbf{x}\|_0}{D}$$&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;$$w_{\mathrm{acc}} \gg w_{\mathrm{feat}}$$&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=center;verticalAlign=top;fontSize=12;fontColor=#0F172A;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="920" y="80" width="420" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>