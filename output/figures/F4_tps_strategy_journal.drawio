id="trans_lbl" value="&amp;lt;b&amp;gt;&amp;lt;font size=&quot;4&quot; color=&quot;#1E3A8A&quot;&amp;gt;Adaptive Weight Scheduling&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;$$(\alpha, \beta): (0.70, 0.30) \longrightarrow (0.95, 0.05)$$&amp;lt;/b&amp;gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=12;fontColor=#0F172A;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="500" y="80" width="300" height="70" as="geometry" /></mxCell><mxCell id="p2_lbl" value="&amp;lt;b&amp;gt;&amp;lt;font size=&quot;4&quot; color=&quot;#1E3A8A&quot;&amp;gt;Phase 2: Accuracy Refinement&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;$$f = \alpha \times \text{Error Rate} + \beta \times \text{Feature Ratio}$$&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;$$\alpha = 0.95, \quad \beta = 0.05$$&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;i&amp;gt;Accuracy-oriented refinement $\cdot$ Elite subset fine-tuning&amp;lt;/i&amp;gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="920" y="80" width="420" height="90" as="geometry" /></mxCell><mxCell id="summary_flow" value="&amp;lt;b&amp;gt;&amp;lt;font color=&quot;#1D4ED8&quot;&amp;gt;Exploration&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;  $$\longrightarrow$$  &amp;lt;b&amp;gt;&amp;lt;font color=&quot;#1D4ED8&quot;&amp;gt;Feature Reduction&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;  $$\longrightarrow$$  &amp;lt;b&amp;gt;&amp;lt;font color=&quot;#1E3A8A&quot;&amp;gt;Weight Transition&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;  $$\longrightarrow$$  &amp;lt;b&amp;gt;&amp;lt;font color=&quot;#1E3A8A&quot;&amp;gt;Accuracy Refinement&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;  $$\longrightarrow$$  &amp;lt;b&amp;gt;&amp;lt;font color=&quot;#1E3A8A&quot;&amp;gt;High-Quality Compact Subset&amp;lt;/font&amp;gt;&amp;lt;/b&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontFamily=Times New Roman;" parent="1" vertex="1"><mxGeometry x="100" y="780" width="1200" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>