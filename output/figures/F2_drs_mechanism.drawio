<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="F2-DRS">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="&lt;b&gt;Figure 2:&lt;/b&gt; Diversity-Regulated Selection (DRS) -- mechanism and theoretical guarantee." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="650" height="22" as="geometry" />
        </mxCell>
        <mxCell id="cl" value="&lt;b&gt;DRS pipeline&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontFamily=Times New Roman;fontColor=#999999;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="45" width="100" height="16" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1&lt;/b&gt;  &lt;b&gt;Current Population P&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;N binary vectors x_i in {0,1}^d, fitness-only selection&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2&lt;/b&gt;  &lt;b&gt;Pairwise NHD Matrix&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;NHD(i,j) = Hamming(x_i, x_j) / d    (symmetric, NHD in [0,1])&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3&lt;/b&gt;  &lt;b&gt;Crowding Distance with NHD Weight&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;CD(i) = (1-a)*CD_fitness(i) + a*MeanNHD(i)&lt;br&gt;a_cd(t) = (t/T)^2 -- diversity weight grows over time&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="205" width="420" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4&lt;/b&gt;  &lt;b&gt;DRS Pool Construction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Sort by CD, select top-k for elite pool&lt;br&gt;NHD elevated to 1st-class selection objective&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE4EF;strokeColor=#4A6485;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5&lt;/b&gt;  &lt;b&gt;Diversity-Maintained Elite Pool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Structurally diverse solutions with NHD(i,j) &amp;gt; 0 sustained&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#4A6485;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ea1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=1.2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=1.2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=1.2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=1.2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pr1_text" value="&lt;b&gt;Statement.&lt;/b&gt; For t &amp;lt; T, the DRS crowding score assigns strictly positive weight&lt;br&gt;      a_nhd(t) = (t / T)^2  &amp;gt;  0&lt;br&gt;to the NHD term. Consequently, for the pool P_t selected at iteration t,&lt;br&gt;      E[ NHD(P_t) ]  &amp;gt;=  a_nhd(t) * E[ NHD_random ]  &amp;gt;  0.&lt;br&gt;&lt;br&gt;&lt;b&gt;Proof sketch.&lt;/b&gt; The crowding score is a convex combination:&lt;br&gt;      CD(i) = (1 - a_nhd)*CD_fitness(i) + a_nhd*MeanNHD(i).&lt;br&gt;Since a_nhd &amp;gt; 0 for all t &amp;lt; T, every individual score includes a positive NHD&lt;br&gt;component, guaranteeing that structurally similar solutions are deprioritized in&lt;br&gt;favor of diverse ones. The bound follows from linearity of expectation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Implication.&lt;/b&gt; Unlike all baseline methods where NHD collapses to zero within&lt;br&gt;early iterations, KDS-EL provably maintains non-zero structural diversity throughout&lt;br&gt;the entire optimization trajectory." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="535" y="75" width="790" height="205" as="geometry" />
        </mxCell>
        <mxCell id="chart_bg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDDD;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="chart_text" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;NHD over iterations (conceptual)&lt;/b&gt;&lt;br&gt;&lt;br&gt;NHD&lt;br&gt;^&lt;br&gt;|  oooo                          KDS-EL/DRS&lt;br&gt;|      oooo                      (NHD &amp;gt; 0, provable)&lt;br&gt;|          oooo&lt;br&gt;|              oooo&lt;br&gt;|                  oooo&lt;br&gt;|________________________________&amp;gt; t&lt;br&gt;  KER / MEL / all SOTA: NHD = 0 (flat line)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=9;fontFamily=Courier New;fontColor=#333333;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="45" y="453" width="450" height="163" as="geometry" />
        </mxCell>
        <mxCell id="wo_drs" value="&lt;b&gt;Without DRS&lt;/b&gt; (KER, MEL, all SOTA)&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;X Population collapses to identical solutions&lt;br&gt;X NHD = 0 after initial iterations -- premature convergence&lt;br&gt;X No structural diversity for heterogeneous perturbation signals&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#C4958A;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;fontColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wi_drs" value="&lt;b&gt;With DRS&lt;/b&gt; (KDS-EL)&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;V NHD &amp;gt; 0 sustained -- provable lower bound (Proposition 1)&lt;br&gt;V 89.2% feature reduction vs MEL (2436 to 263)&lt;br&gt;V Enables KER to operate on structurally diverse population&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#4A6485;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="660" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="drse" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=2;endArrow=block;endFill=1;endSize=6;fontSize=9;fontFamily=Times New Roman;fontColor=#4A6485;fontStyle=1;" edge="1" parent="1" source="wo_drs" target="wi_drs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="insight2" value="&lt;font style=&quot;font-size:8.5px;font-style:italic&quot;&gt;&lt;b&gt;Key insight:&lt;/b&gt; DRS value is structural -- it does not directly improve accuracy (Full vs KER dAcc = +0.0020, Fisher p = 6.5e-4). Instead, it maintains the population diversity scaffold that (a) enables KER knowledge accumulation on heterogeneous candidates, (b) compresses feature subsets (-89.2% vs MEL), and (c) provides a provable guarantee against premature structural collapse.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;strokeWidth=1;fontSize=9;fontFamily=Times New Roman;fontColor=#888888;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="755" width="1040" height="42" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
