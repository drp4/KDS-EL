        </mxCell>
        <mxCell id="31" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDDD;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="172" width="330" x="620" y="62" as="geometry" />
        </mxCell>
        <mxCell id="32" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=9;fontFamily=Courier New;fontColor=#333333;align=left;spacingLeft=10;spacingTop=8;" value="&lt;font style=&quot;font-size:8.5px&quot;&gt;&lt;b&gt;Feature importance (bar chart)&lt;/b&gt;&lt;br&gt;&lt;br&gt;f₁₂₇  ████████████████  &lt;b&gt;16&lt;/b&gt;&lt;br&gt;f₃₅₆  ██████████████    &lt;b&gt;14&lt;/b&gt;&lt;br&gt;f₈₉   ██████████        &lt;b&gt;10&lt;/b&gt;&lt;br&gt;f₅₀₁  ████████          &lt;b&gt; 8&lt;/b&gt;&lt;br&gt;f₂₃   ██████            &lt;b&gt; 6&lt;/b&gt;&lt;br&gt;f₄₄₂  ████              &lt;b&gt; 4&lt;/b&gt;&lt;br&gt;f₇₁   ██                &lt;b&gt; 2&lt;/b&gt;&lt;br&gt;  ···                     &lt;b&gt;0&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="165" width="320" x="625" y="65" as="geometry" />
        </mxCell>
        <mxCell id="33" edge="1" parent="1" source="8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#AAAAAA;strokeWidth=0.8;dashed=1;endArrow=block;endFill=1;endSize=4;" target="31" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="335" />
              <mxPoint x="540" y="148" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="34" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2ED;strokeColor=#4A704A;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;Proposition 2: Ergodicity Guarantee&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#4A704A;&quot;&gt;P(flip j)  ≥  (1/N) · (w_j / Σ_k w_k) · p_mut&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#555555;&quot;&gt;&lt;b&gt;Proof:&lt;/b&gt; KER selects N features without replacement, each proportionally to w_j.&lt;br&gt;Any feature with w_j &amp;gt; 0 has selection probability ≥ (1/N)·(w_j / Σw)·p_mut.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#4A704A;&quot;&gt;&lt;b&gt;Consequence (Weak Ergodicity):&lt;/b&gt; From any x_0, any target subset x* is reachable in finite expected steps. Unlike random perturbation, KER directs exploration toward historically useful features without search-space foreclosure.&lt;/font&gt;" vertex="1">
          <mxGeometry height="145" width="330" x="620" y="250" as="geometry" />
        </mxCell>
        <mxCell id="39" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#C4958A;strokeWidth=1;fontSize=9;fontFamily=Times New Roman;fontColor=#555555;align=left;spacingLeft=10;" value="&lt;b&gt;Without KER&lt;/b&gt; (MEL, PSO)&lt;br&gt;&lt;font style=&quot;font-size:7.5px;&quot;&gt;✗ Signals discarded after Pbest update&lt;br&gt;✗ Random perturbation — undirected, slow&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="330" x="620" y="415" as="geometry" />
        </mxCell>
        <mxCell id="41" edge="1" parent="1" source="39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A704A;strokeWidth=2;endArrow=block;endFill=1;endSize=6;fontSize=8;fontFamily=Times New Roman;fontColor=#4A704A;fontStyle=1;align=center;" target="40" value="&lt;b&gt;KER&lt;br&gt;enables&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="785" y="485" as="sourcePoint" />
            <mxPoint x="785" y="505" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="40" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2ED;strokeColor=#4A704A;strokeWidth=1.5;fontSize=9;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=10;" value="&lt;b&gt;With KER&lt;/b&gt; (KDS-EL)&lt;br&gt;&lt;font style=&quot;font-size:7.5px;&quot;&gt;✓ +4.68 pp over MEL (25 datasets, p &amp;lt; 10⁻⁴)&lt;br&gt;✓ KER captures ~99.8% of KDS-EL total accuracy gain&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="330" x="620" y="490" as="geometry" />
        </mxCell>
        <mxCell id="42" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;strokeWidth=1;fontSize=8.5;fontFamily=Times New Roman;fontColor=#888888;align=left;spacingLeft=14;" value="&lt;font style=&quot;font-size:8px;font-style:italic&quot;&gt;&lt;b&gt;DRS + KER integration:&lt;/b&gt; KER is the primary accuracy engine — it captures virtually all of KDS-EL&#39;s accuracy improvement over MEL (+4.68 pp, p&amp;lt;10⁻⁴). DRS provides the structural scaffold (diversity&amp;gt;0, 89.2% feature compression) enabling KER to operate on heterogeneous populations. Together they approach Pareto-front performance (Acc 0.9450, rank #2/15).&lt;/font&gt;" vertex="1">
          <mxGeometry height="32" width="1240" x="50" y="560" as="geometry" />
        </mxCell>
      </root>
