        <mxCell id="9" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE8DC;strokeColor=#4A704A;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;fontStyle=1;" value="&lt;b&gt;KER-guided Perturbation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.5px&quot;&gt;P(flip j) ∝ w_j / Σ_k w_k — features with high historical impact perturbed more&lt;/font&gt;" vertex="1">
