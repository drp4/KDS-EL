        <mxCell id="r6HwrUcJBjmNeR2q8TTc-9" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;" value="&lt;b&gt;1. NHD Matrix&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;NHD(i,j) = Hamming(x_i, x_j) / d, symmetric, NHD∈[0,1]&lt;/font&gt;" vertex="1">
