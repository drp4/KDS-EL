<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="F1-KDS-EL-Complementarity">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- === TITLE === -->
        <mxCell id="2" value="&lt;b&gt;Figure 1:&lt;/b&gt; KDS-EL dual-space framework — complementarity of DRS and KER." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="8" width="700" height="20" as="geometry" />
        </mxCell>

        <!-- === INPUT === -->
        <mxCell id="3" value="&lt;b&gt;High-Dimensional Data&lt;/b&gt; (d &amp;gt;&amp;gt; n)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F4EF;strokeColor=#8B7D6B;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="220" height="36" as="geometry" />
        </mxCell>

        <!-- === CHALLENGE TAGS === -->
        <mxCell id="4" value="&lt;b&gt;Challenge A:&lt;/b&gt; Population Homogenization" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#C4958A;strokeWidth=1;fontSize=9;fontFamily=Times New Roman;fontColor=#554433;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="95" width="320" height="24" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;Challenge B:&lt;/b&gt; Improvement Signal Waste" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#C4958A;strokeWidth=1;fontSize=9;fontFamily=Times New Roman;fontColor=#554433;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="345" width="320" height="24" as="geometry" />
        </mxCell>

        <!-- Input → Challenges connectors -->
        <mxCell id="6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;endArrow=block;endFill=1;endSize=4;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="535" y="85" />
              <mxPoint x="210" y="85" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;endArrow=block;endFill=1;endSize=4;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x= "650" y="85" />
              <mxPoint x="210" y="85" />
              <mxPoint x="210" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === DRS LANE (TOP) === -->
        <!-- Container -->
        <mxCell id="8" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#7A8FA8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="1180" height="225" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;Structure Space — DRS&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontFamily=Times New Roman;fontColor=#4A6485;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="126" width="200" height="16" as="geometry" />
        </mxCell>

        <!-- Without DRS panel -->
        <mxCell id="10" value="&lt;b&gt;Without DRS&lt;/b&gt; (MEL, classical PSO)&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#555555;&quot;&gt;✗ Population collapses to identical solutions&lt;br&gt;✗ NHD = 0 — premature structural convergence&lt;br&gt;✗ Fitness-only selection ignores solution diversity&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#C4958A;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#555555;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="440" height="170" as="geometry" />
        </mxCell>

        <!-- Transition arrow -->
        <mxCell id="11" value="&lt;b&gt;DRS introduces NHD&lt;br&gt;as 1st-class objective&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=2;endArrow=block;endFill=1;endSize=6;fontSize=9;fontFamily=Times New Roman;fontColor=#4A6485;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="235" as="sourcePoint" />
            <mxPoint x="630" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- With DRS panel -->
        <mxCell id="12" value="&lt;b&gt;With DRS (KDS-EL)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#333333;&quot;&gt;✓ α_cd(t) = (t/T)² &amp;gt; 0 — provable diversity weight&lt;br&gt;✓ E[NHD(pool)] &amp;gt; 0 — structural diversity guaranteed&lt;br&gt;✓ DRS Pool: NHD as Pareto selection criterion&lt;br&gt;✓ 89.2% feature reduction vs MEL (2436→263)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCE4EF;strokeColor=#4A6485;strokeWidth=1.5;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="150" width="440" height="170" as="geometry" />
        </mxCell>

        <!-- Proposition 1 callout (within With DRS panel, bottom-right) -->
        <mxCell id="13" value="&lt;b&gt;Prop. 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.5px&quot;&gt;E[NHD(pool)] &amp;gt; 0&lt;br&gt;diversity lower bound&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#4A6485;strokeWidth=1;fontSize=8.5;fontFamily=Times New Roman;fontColor=#4A6485;" vertex="1" parent="1">
          <mxGeometry x="910" y="265" width="95" height="42" as="geometry" />
        </mxCell>

        <!-- === KER LANE (BOTTOM) === -->
        <!-- Container -->
        <mxCell id="14" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDF2ED;strokeColor=#7A9A7A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="370" width="1180" height="225" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;Fitness Space — KER&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontFamily=Times New Roman;fontColor=#4A704A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="376" width="200" height="16" as="geometry" />
        </mxCell>

        <!-- Without KER panel -->
        <mxCell id="16" value="&lt;b&gt;Without KER&lt;/b&gt; (MEL, classical PSO)&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#555555;&quot;&gt;✗ Improvement signals discarded after Pbest update&lt;br&gt;✗ Random perturbation — undirected, slow convergence&lt;br&gt;✗ No memory of which features drove past improvements&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#C4958A;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#555555;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="440" height="170" as="geometry" />
        </mxCell>

        <!-- Transition arrow -->
        <mxCell id="17" value="&lt;b&gt;KER records improvement&lt;br&gt;events as weights&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A704A;strokeWidth=2;endArrow=block;endFill=1;endSize=6;fontSize=9;fontFamily=Times New Roman;fontColor=#4A704A;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="485" as="sourcePoint" />
            <mxPoint x="630" y="485" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- With KER panel -->
        <mxCell id="18" value="&lt;b&gt;With KER (KDS-EL)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#333333;&quot;&gt;✓ Improvement events → weight vector w (online learning)&lt;br&gt;✓ Directed perturbation: P(flip j) ∝ w_j&lt;br&gt;✓ +4.68 pp over MEL (25 datasets, p &amp;lt; 10⁻⁴)&lt;br&gt;✓ KER captures ~99.8% of KDS-EL total accuracy gain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCE8DC;strokeColor=#4A704A;strokeWidth=1.5;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="400" width="440" height="170" as="geometry" />
        </mxCell>

        <!-- Proposition 2 callout (within With KER panel, bottom-right) -->
        <mxCell id="19" value="&lt;b&gt;Prop. 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.5px&quot;&gt;P(flip j) ≥ (1/N)(w_j/Σw)·p_mut&lt;br&gt;any subset reachable&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2ED;strokeColor=#4A704A;strokeWidth=1;fontSize=8.5;fontFamily=Times New Roman;fontColor=#4A704A;" vertex="1" parent="1">
          <mxGeometry x="920" y="515" width="95" height="42" as="geometry" />
        </mxCell>

        <!-- === BIDIRECTIONAL EXCHANGE (CENTER GAP) === -->
        <!-- DRS→KER: Diverse candidates (downward) -->
        <mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;Diverse candidates&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=8;fontFamily=Times New Roman;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="840" y="335" width="80" height="20" as="geometry" />
        </mxCell>

        <!-- KER→DRS: Guided elites (upward) -->
        <mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#777777;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="18" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;Guided elites&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=8;fontFamily=Times New Roman;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="700" y="335" width="75" height="20" as="geometry" />
        </mxCell>

        <!-- === STAT BADGES (RIGHT SIDE) === -->
        <mxCell id="24" value="&lt;b&gt;KDS-EL Acc: 0.9450&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.5px&quot;&gt;#2/15 methods&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F0F0F5;strokeColor=#AAAAAA;strokeWidth=0.8;fontSize=8.5;fontFamily=Times New Roman;fontColor=#555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="1110" y="150" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;Feature reduction: 89.2%&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.5px&quot;&gt;263 vs 2436 features&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F0F0F5;strokeColor=#AAAAAA;strokeWidth=0.8;fontSize=8.5;fontFamily=Times New Roman;fontColor=#555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="1110" y="230" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;NHD maintained: &amp;gt;0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.5px&quot;&gt;Provable diversity bound&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F0F0F5;strokeColor=#AAAAAA;strokeWidth=0.8;fontSize=8.5;fontFamily=Times New Roman;fontColor=#555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="1110" y="310" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="27" value="&lt;b&gt;+4.88pp over MEL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.5px&quot;&gt;p &amp;lt; 10⁻⁴&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F0F0F5;strokeColor=#AAAAAA;strokeWidth=0.8;fontSize=8.5;fontFamily=Times New Roman;fontColor=#555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="1110" y="390" width="130" height="40" as="geometry" />
        </mxCell>

        <!-- === OUTPUT === -->
        <mxCell id="28" value="&lt;b&gt;Single Optimal Feature Subset&lt;/b&gt;  —  biomarker panel with high accuracy, compact size, and structural diversity" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F0F5;strokeColor=#6A6A80;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="620" width="660" height="40" as="geometry" />
        </mxCell>

        <!-- Arrows to Output -->
        <mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6A6A80;strokeWidth=1;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="12" target="28">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="595" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6A6A80;strokeWidth=1;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="18" target="28">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="595" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === COMPLEMENTARITY NOTE === -->
        <mxCell id="31" value="&lt;font style=&quot;font-size:8px;font-style:italic;color:#888888;&quot;&gt;&lt;b&gt;Complementarity in action:&lt;/b&gt; DRS solves KER's diversity problem (NHD=0→NHD&amp;gt;0). KER solves DRS's accuracy problem (no learning→weight-guided search). Together they achieve Acc 0.9450, rank #2/15 — but each alone is incomplete.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;strokeWidth=1;fontSize=8;fontFamily=Times New Roman;fontColor=#888888;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="685" width="900" height="28" as="geometry" />
        </mxCell>

      </root>
