<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="F2-DRS-Mechanism">
    <mxGraphModel dx="1400" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- === TITLE === -->
        <mxCell id="2" value="&lt;b&gt;Figure 2:&lt;/b&gt; Diversity-Regulated Selection (DRS) — mechanism and theoretical guarantee." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Times New Roman;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="750" height="22" as="geometry" />
        </mxCell>

        <!-- === PIPELINE LABEL === -->
        <mxCell id="43" value="&lt;b&gt;DRS pipeline&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontFamily=Times New Roman;fontColor=#999999;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="42" width="100" height="16" as="geometry" />
        </mxCell>

        <!-- === LEFT COLUMN: PIPELINE === -->
        <!-- Step 1 -->
        <mxCell id="3" value="&lt;b&gt;1. Current Population P&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;N binary vectors x_i in {0,1}^d&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="62" width="540" height="38" as="geometry" />
        </mxCell>

        <!-- Arrow 1→2 -->
        <mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=1.2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="4" value="&lt;b&gt;2. Pairwise NHD Matrix&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;NHD(i,j) = Hamming(x_i, x_j) / d    (symmetric, NHD in [0,1])&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="540" height="38" as="geometry" />
        </mxCell>

        <!-- Arrow 2→3 -->
        <mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=1.2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="5" value="&lt;b&gt;3. Crowding Distance (NHD-weighted)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;CD(i) = (1-α)·CD_fitness(i) + α·MeanNHD(i)&lt;br&gt;α_cd(t) = (t/T)² — diversity weight grows over time&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA3BE;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="178" width="540" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow 3→4 -->
        <mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=1.2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 4 (HIGHLIGHTED) -->
        <mxCell id="6" value="&lt;b&gt;4. DRS Pool Construction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Sort by CD, select top-k for elite pool&lt;br&gt;NHD elevated to 1st-class selection objective&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCE4EF;strokeColor=#4A6485;strokeWidth=1.5;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="248" width="540" height="44" as="geometry" />
        </mxCell>

        <!-- Arrow 4→5 -->
        <mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=1.2;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="7" value="&lt;b&gt;5. Diversity-Maintained Elite Pool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Structurally diverse solutions with NHD &amp;gt; 0 sustained&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A6485;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="312" width="540" height="38" as="geometry" />
        </mxCell>

        <!-- === RIGHT COLUMN: PROOF CARD === -->
        <mxCell id="12" value="&lt;b&gt;Proposition 1: Diversity Lower Bound&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4A6485;&quot;&gt;E[NHD(P_t)]  ≥  α_nhd(t) · E[NHD_random]  &amp;gt;  0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#555555;&quot;&gt;where  α_nhd(t) = (t/T)²  (strictly positive for all t &amp;lt; T)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#333333;&quot;&gt;Proof: CD(i) = (1-α_nhd)·CD_fitness(i) + α_nhd·MeanNHD(i).&lt;br&gt;Since α_nhd &amp;gt; 0 for all t &amp;lt; T, NHD contributes positively to selection.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:8.5px;color:#4A6485;&quot;&gt;Key: Unlike all baselines where NHD→0, KDS-EL provably maintains NHD&amp;gt;0 throughout the entire search.&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#4A6485;strokeWidth=1.5;fontSize=10;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="62" width="630" height="165" as="geometry" />
        </mxCell>

        <!-- === RIGHT COLUMN BOTTOM: COMPARISON === -->
        <!-- Without DRS -->
        <mxCell id="15" value="&lt;b&gt;Without DRS&lt;/b&gt; (KER, MEL, all SOTA)&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;✗ Population collapses to identical solutions&lt;br&gt;✗ NHD = 0 after initial iterations&lt;br&gt;✗ No structural diversity for KER signals&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#C4958A;strokeWidth=1;fontSize=9.5;fontFamily=Times New Roman;fontColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="248" width="280" height="102" as="geometry" />
        </mxCell>

        <!-- Arrow Without→With -->
        <mxCell id="17" value="&lt;b&gt;DRS&lt;br&gt;enables&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=2;endArrow=block;endFill=1;endSize=6;fontSize=8;fontFamily=Times New Roman;fontColor=#4A6485;fontStyle=1;align=center;" edge="1" parent="1" source="15" target="16">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="985" y="299" as="sourcePoint" />
            <mxPoint x="1025" y="299" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- With DRS -->
        <mxCell id="16" value="&lt;b&gt;With DRS&lt;/b&gt; (KDS-EL)&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;✓ NHD &amp;gt; 0 sustained — provable lower bound&lt;br&gt;✓ 89.2% feature reduction vs MEL (2436→263)&lt;br&gt;✓ Enables KER to exploit structural diversity&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#4A6485;strokeWidth=1.5;fontSize=9.5;fontFamily=Times New Roman;fontColor=#333333;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="248" width="290" height="102" as="geometry" />
        </mxCell>

        <!-- Arrow from Step 5 (Diverse Pool) → With DRS panel -->
        <mxCell id="40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6485;strokeWidth=1;dashed=1;endArrow=block;endFill=1;endSize=4;" edge="1" parent="1" source="7" target="16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === BOTTOM LEFT: NHD CHART === -->
        <mxCell id="13" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="390" width="630" height="130" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;NHD over iterations&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-family:Courier New;&quot;&gt;NHD&lt;br&gt;^&amp;emsp;&amp;emsp;&amp;emsp;KDS-EL (DRS): NHD &amp;gt; 0 (provable)&lt;br&gt;|&amp;emsp;&amp;emsp;╱╲&lt;br&gt;|&amp;emsp;╱&amp;emsp;╲&lt;br&gt;|&amp;emsp;╱&amp;emsp;&amp;emsp;╲&lt;br&gt;|&amp;emsp;╱&amp;emsp;&amp;emsp;&amp;emsp;╲&lt;br&gt;|╱&amp;emsp;&amp;emsp;&amp;emsp;&amp;emsp;&amp;emsp;╲&lt;br&gt;|__________________________&amp;gt; t &lt;br&gt;&amp;emsp;--- MEL/KER/SOTA: NHD = 0 (flat)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=8;fontFamily=Courier New;fontColor=#555555;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="395" width="620" height="120" as="geometry" />
        </mxCell>

        <!-- === BOTTOM RIGHT: KEY INSIGHT === -->
        <mxCell id="18" value="&lt;font style=&quot;font-size:8.5px;font-style:italic&quot;&gt;&lt;b&gt;Key insight:&lt;/b&gt; DRS value is structural — it does not directly improve accuracy (Full vs KER ΔAcc = +0.0020, Fisher p = 6.5e-4). Instead, it maintains the population diversity scaffold that (a) enables KER knowledge accumulation on heterogeneous candidates, (b) compresses feature subsets (−89.2% vs MEL), and (c) provides a provable guarantee against premature structural collapse.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;strokeWidth=1;fontSize=8.5;fontFamily=Times New Roman;fontColor=#888888;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="390" width="600" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
