\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Illustration of the DRS mechanism. (a)~Bi-objective Pareto selection: solutions are sorted by fitness and NHD, with the Pareto front $\mathcal  {F}_1$ receiving priority. (b)~Adaptive schedule $\alpha _{\mathrm  {cd}}(t) = (t/T)^2$: early iterations prioritise diversity (green region), while later iterations prioritise fitness precision (red region).}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:drs}{{2}{5}{Illustration of the DRS mechanism. (a)~Bi-objective Pareto selection: solutions are sorted by fitness and NHD, with the Pareto front $\mathcal {F}_1$ receiving priority. (b)~Adaptive schedule $\alpha _{\mathrm {cd}}(t) = (t/T)^2$: early iterations prioritise diversity (green region), while later iterations prioritise fitness precision (red region)}{figure.2}{}}
\newlabel{eq:flip_prob}{{9}{5}{Knowledge-Guided Elite Refinement (KER)}{equation.9}{}}
\newlabel{prop:ker}{{2}{5}{Ergodicity}{proposition.2}{}}
