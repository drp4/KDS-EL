\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Illustration of the KER mechanism. (a)~Improvement-feedback weight update: when a new solution improves upon $P_{\mathrm  {best}}$, the weight vector $\mathbf  {w}$ is updated before $P_{\mathrm  {best}}$ is replaced. (b)~Elite perturbation: features with high $|w_j|$ have higher flip probability, while random flips with probability $p_r = 0.10$ guarantee ergodicity.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:ker}{{3}{6}{Illustration of the KER mechanism. (a)~Improvement-feedback weight update: when a new solution improves upon $P_{\mathrm {best}}$, the weight vector $\mathbf {w}$ is updated before $P_{\mathrm {best}}$ is replaced. (b)~Elite perturbation: features with high $|w_j|$ have higher flip probability, while random flips with probability $p_r = 0.10$ guarantee ergodicity}{figure.3}{}}
\newlabel{eq:complexity}{{10}{6}{Time Complexity Analysis}{equation.10}{}}
