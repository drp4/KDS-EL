\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Schematic representation of prior-guided sparse population initialization and adaptive diversity recovery. Step~1 injects mutual information priors into continuous candidate vectors, Steps~2--3 trace generational convergence toward compact subsets, and Step~4 triggers adaptive re-initialization upon reaching the stagnation threshold $\tau $ to restore swarm diversity.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:mi_seeding}{{3}{6}{Schematic representation of prior-guided sparse population initialization and adaptive diversity recovery. Step~1 injects mutual information priors into continuous candidate vectors, Steps~2--3 trace generational convergence toward compact subsets, and Step~4 triggers adaptive re-initialization upon reaching the stagnation threshold $\tau $ to restore swarm diversity}{figure.3}{}}
