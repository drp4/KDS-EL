\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overall architectural pipeline of KDS-EL: high-dimensional data undergo filter-based mutual information ranking, dual-subpopulation initialization with Gaussian perturbation, two-phase dynamic objective weight scheduling, cross-iteration cumulative feature-importance matrix accumulation with exponential decay, and knowledge-guided elite refinement with 1-to-1 in-place replacement.}}{21}{figure.1}\protected@file@percent }
\newlabel{F1}{{1}{21}{Overall architectural pipeline of KDS-EL: high-dimensional data undergo filter-based mutual information ranking, dual-subpopulation initialization with Gaussian perturbation, two-phase dynamic objective weight scheduling, cross-iteration cumulative feature-importance matrix accumulation with exponential decay, and knowledge-guided elite refinement with 1-to-1 in-place replacement}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Operational mechanism of MI-Prior Seeding and Adaptive Re-injection: mutual information $I(f_j; \mathbf  {Y})$ extracts continuous feature--target dependency to construct a normalized prior vector $\mathaccent "019B\relax {\mathbf  {m}} \in [0, 1]^D$, which biases $50\%$ of initial particles with Gaussian perturbation while the remaining $50\%$ undergo uniform random exploration; when evolutionary search encounters stagnation ($\mathrm  {stall} \ge 20$), the MI prior is adaptively re-injected into inferior particles to restore search vitality.}}{22}{figure.2}\protected@file@percent }
\newlabel{F2}{{2}{22}{Operational mechanism of MI-Prior Seeding and Adaptive Re-injection: mutual information $I(f_j; \mathbf {Y})$ extracts continuous feature--target dependency to construct a normalized prior vector $\widetilde {\mathbf {m}} \in [0, 1]^D$, which biases $50\%$ of initial particles with Gaussian perturbation while the remaining $50\%$ undergo uniform random exploration; when evolutionary search encounters stagnation ($\mathrm {stall} \ge 20$), the MI prior is adaptively re-injected into inferior particles to restore search vitality}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Operational workflow of the Knowledge-guided Elite Refinement (KER) strategy: candidate elites undergo either knowledge-guided directional refinement ($p=0.90$) guided by cumulative matrix $W$ or ergodic random exploration ($p=0.10$), evaluated in a closed-loop and admitted via greedy 1-to-1 in-place replacement.}}{22}{figure.3}\protected@file@percent }
\newlabel{F3}{{3}{22}{Operational workflow of the Knowledge-guided Elite Refinement (KER) strategy: candidate elites undergo either knowledge-guided directional refinement ($p=0.90$) guided by cumulative matrix $W$ or ergodic random exploration ($p=0.10$), evaluated in a closed-loop and admitted via greedy 1-to-1 in-place replacement}{figure.3}{}}
